# Copy to .env and fill in. Never commit .env.

# Display name and User-Agent tag (the one place to rename the app); empty = askfirst
APP_NAME=
# Folder for the SQLite files and run folders; empty = data
DATA_DIR=

# Log level: DEBUG, INFO, WARNING or ERROR; empty = INFO
LOG_LEVEL=
# Log format: json (CI, Docker) or console (easy to read in a terminal); empty = json
LOG_FORMAT=

# LLM provider: fake (no network; tests/CI/offline demos), groq or anthropic (paid); empty = fake
LLM_PROVIDER=
# Model id for the provider; empty = the provider's default
LLM_MODEL=
# Provider to try when the main one fails: fake, groq or anthropic; empty = no fallback
LLM_FALLBACK=
