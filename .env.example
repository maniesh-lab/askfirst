# Copy to .env and fill in. Never commit .env.

# Display name and User-Agent tag (the one place to rename the app); empty = askfirst
APP_NAME=
# Folder for the SQLite files and run folders; empty = data
DATA_DIR=

# Log level: DEBUG, INFO, WARNING or ERROR; empty = INFO
LOG_LEVEL=
# Log format: json (CI, Docker) or console (easy to read in a terminal); empty = json
LOG_FORMAT=

# LLM provider: fake (no network; tests/CI/offline demos), groq, anthropic (paid) or openai (paid); empty = fake
LLM_PROVIDER=
# Model id for the provider; empty = the provider's default
LLM_MODEL=
# Provider to try when the main one fails: fake, groq, anthropic or openai; empty = no fallback
LLM_FALLBACK=
# Groq API key (free tier); needed when LLM_PROVIDER or LLM_FALLBACK is groq
GROQ_API_KEY=
# Anthropic API key (paid, optional); only used when a provider setting is anthropic
ANTHROPIC_API_KEY=
# OpenAI API key (paid, optional; needs pip install -e ".[openai]"); only used when a provider setting is openai
OPENAI_API_KEY=

# Discord webhook for the triage digest channel; empty = digests are only logged
DISCORD_WEBHOOK_URL=
# Discord webhook for "a review is waiting" pings (no personal data); empty = no pings
DISCORD_REVIEW_WEBHOOK_URL=

# Hosts the browser may load, comma-separated (add your deployed practice site's host here)
ALLOWED_HOSTS=
# false = show the browser window (for watching or the demo); empty = true
HEADLESS=
# Debugging only: save a Playwright trace (.zip) per browser session here; it holds everything typed, so never for real accounts. Empty = off
PLAYWRIGHT_TRACE_DIR=

# Practice site (our own test forms). Base URL the agent uses for site:practice/... targets
PRACTICE_BASE_URL=
# Fake seller login for the practice marketplace; empty = seller@example.test
PRACTICE_SELLER_EMAIL=
# Fake seller password (never a real one); empty = the built-in practice password
PRACTICE_SELLER_PASSWORD=
# Signs the practice site's cookies and form tokens; set your own on a public deploy
PRACTICE_SECRET=
# 1 = allow DELETE /api/submissions and POST /api/variant (tests, local only); empty = off
PRACTICE_ALLOW_RESET=
# a = normal pages, b = the job form's phone field is renamed; empty = a
PRACTICE_VARIANT=
# Where `python -m practice_site` listens; empty = 127.0.0.1 and 8800 (the Docker image sets 0.0.0.0)
PRACTICE_HOST=
PRACTICE_PORT=
# Where the practice site keeps its submissions SQLite file; empty = practice_site/data
PRACTICE_DATA_DIR=

# Triage bot: fine-grained GitHub PAT (Issues read/write + Metadata read on TRIAGE_REPO only)
TRIAGE_GITHUB_TOKEN=
# Repo to triage, as owner/name (e.g. maniesh-lab/askfirst-sandbox)
TRIAGE_REPO=
# propose = no changes to issues, only list proposals (the bot's log issue still gets one comment per run); apply-labels = also add allowlisted labels; empty = propose
TRIAGE_MODE=
